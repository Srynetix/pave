# What the files already do, written down so an editor does it too. swift-format
# has the last word on Swift (.swift-format); this is for everything it does not
# format, and for the editor before it has run. From p-suite's template.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,py}]
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 2

[justfile]
indent_style = space
indent_size = 4

[*.{json,xcstrings,plist,toml,yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
