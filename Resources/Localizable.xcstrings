{
  "sourceLanguage": "en",
  "strings": {
    "%@ (main)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (principal)"
          }
        }
      }
    },
    "%@ + arrows move · %@⌥ + arrows focus · %@⌥⇧ + arrows resize · %@⇧Space floating": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ + arrows move · %2$@⌥ + arrows focus · %3$@⌥⇧ + arrows resize · %4$@⇧Space floating"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ + flèches déplace · %@⌥ + flèches focus · %@⌥⇧ + flèches redimensionne · %@⇧Espace flottante"
          }
        }
      }
    },
    "%@ is a built-in layout: choose another name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est une disposition intégrée : choisissez un autre nom"
          }
        }
      }
    },
    "%@ is already used by “%@”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ is already used by “%2$@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sert déjà à « %@ »."
          }
        }
      }
    },
    "%@ · hidden windows: %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · hidden windows: %2$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · fenêtres cachées : %lld"
          }
        }
      }
    },
    "%@1…9 shows a workspace on its screen, %@⇧1…9 sends the active window there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@1…9 shows a workspace on its screen, %2$@⇧1…9 sends the active window there."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@1…9 affiche un workspace sur son écran, %@⇧1…9 y envoie la fenêtre active."
          }
        }
      }
    },
    "%@1…9 shows a workspace on its screen, %@⇧1…9 sends the window there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@1…9 affiche un workspace sur son écran, %@⇧1…9 y envoie la fenêtre."
          }
        }
      }
    },
    "%lld open window(s)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fenêtre(s) ouverte(s)"
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "%lld windows in %lld apps": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld windows in %2$lld apps"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fenêtres dans %lld apps"
          }
        }
      }
    },
    "%lld windows in %lld apps · not responding: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld windows in %2$lld apps · not responding: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fenêtres dans %lld apps · figées : %@"
          }
        }
      }
    },
    "%lld windows · %lld apps": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fenêtres · %lld apps"
          }
        }
      }
    },
    "%lld zones": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld zones"
          }
        }
      }
    },
    "%lld zones · built-in": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld zones · intégrée"
          }
        }
      }
    },
    "1–%lld put the window in that zone · ↩ apply the layout only · arrows back · esc cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–%lld place la fenêtre dans cette zone · ↩ applique seulement la disposition · flèches retour · échap annule"
          }
        }
      }
    },
    "1–9 choose · arrows move · ↩ apply · E edit · esc cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–9 choisit · flèches déplacent · ↩ applique · E modifie · échap annule"
          }
        }
      }
    },
    "1–9 choose, then a zone's number puts the window there · arrows move · ↩ apply · E edit · esc cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–9 choisit, puis le numéro d’une zone y place la fenêtre · flèches déplacent · ↩ applique · E modifie · échap annule"
          }
        }
      }
    },
    "1–9 restore · ↩ restore · S save current · esc cancel": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1–9 rétablit · ↩ rétablit · S enregistre l'actuel · échap annule"
          }
        }
      }
    },
    "A few steps: the permissions Pavé needs, your keyboard, and what to turn on. Everything can be changed later in Settings, or in the config file.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques étapes : les permissions dont Pavé a besoin, votre clavier, et ce que vous voulez activer. Tout se change ensuite dans les Réglages ou dans le fichier de configuration."
          }
        }
      }
    },
    "A name of letters, digits, spaces, - or _": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom fait de lettres, chiffres, espaces, - ou _"
          }
        }
      }
    },
    "A window dropped near another one or the screen's edge sticks to it. ⌥ while dragging: no magnet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre lâchée près d’une autre ou du bord de l’écran s’y colle. ⌥ pendant le glisser : pas d’aimant."
          }
        }
      }
    },
    "About Pavé": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Pavé"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        }
      }
    },
    "Accessibility missing: Settings…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité manquante : Réglages…"
          }
        }
      }
    },
    "Add a rule": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une règle"
          }
        }
      }
    },
    "Add a title rule": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une règle de titre"
          }
        }
      }
    },
    "Add an app": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une app"
          }
        }
      }
    },
    "All %@ Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les fenêtres de %@"
          }
        }
      }
    },
