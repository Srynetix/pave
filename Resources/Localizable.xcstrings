    "Continue once Accessibility is granted (macOS may ask to quit and reopen Pavé).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez une fois l'Accessibilité accordée (macOS peut demander de quitter et rouvrir Pavé)."
          }
        }
      }
    },
