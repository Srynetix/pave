      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les workspaces"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours"
          }
        }
      }
