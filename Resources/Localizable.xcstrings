    "Could not restart Pavé": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de redémarrer Pavé"
          }
        }
      }
    },
    "Covers the taskbar": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvre la barre"
          }
        }
