      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours le %lld"
          }
        }
      }
    },
    "Always (one entry per app)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours (une entrée par app)"
          }
        }
      }
    },
    "An emoji, up to 2 letters, or sf: and an SF Symbol name": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un emoji, jusqu’à 2 lettres, ou sf: suivi du nom d’un symbole SF"
          }
        }
      }
    },
    "App rules": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles par app"
          }
        }
      }
    },
    "Applies when Pavé restarts.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pris en compte au redémarrage de Pavé."
          }
        }
      }
    },
    "Apps not responding: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps figées : %@"
          }
        }
      }
    },
    "Arrangement not saved": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agencement non enregistré"
          }
        }
      }
    },
    "Arrows move between zones": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flèches passent d'une zone à l'autre"
          }
        }
      }
    },
    "At launch and once a day. Nothing is installed without asking.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au lancement, puis une fois par jour. Rien n'est installé sans demander."
          }
        }
      }
    },
    "At most %lld zones": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld zones au plus"
          }
        }
      }
    },
    "At the bottom of each screen, with the windows of the workspace shown.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En bas de chaque écran, avec les fenêtres du workspace affiché."
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retour"
          }
        }
      }
    },
    "Bring Back All Windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramener toutes les fenêtres"
          }
        }
      }
    },
    "Bring back all windows": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramener toutes les fenêtres"
          }
        }
      }
    },
