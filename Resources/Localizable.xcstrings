    "Delete this title rule": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette règle de titre"
          }
        }
      }
    },
    "Development build: updates go to the copy in Applications": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de développement : les mises à jour vont à la copie dans Applications"
          }
        }
      }
    },
    "Dialogs, sheets and panels (Open, Save, Settings) are never placed, whatever the rule.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dialogues, feuilles et panneaux (Ouvrir, Enregistrer, Réglages) ne sont jamais placés, quelle que soit la règle."
          }
        }
      }
    },
    "Drag a window to an edge to snap it, hold ⌥ to move it freely. Pavé lives in the menu bar: Settings, logs and help are there.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissez une fenêtre vers un bord pour l'aimanter, tenez ⌥ pour la déplacer librement. Pavé vit dans la barre des menus : Réglages, journaux et aide s'y trouvent."
          }
        }
      }
    },
    "Drag snap": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Colle au bord"
          }
        }
      }
    },
    "Drag to reorder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse pour changer l'ordre."
          }
        }
      }
    },
    "Each window's app, workspace and place are saved, never its title. The same name replaces the arrangement.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app, le workspace et la place de chaque fenêtre sont enregistrés, jamais son titre. Le même nom remplace l'agencement."
          }
        }
      }
    },
