    "PC habits (recommended)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Habitudes PC (recommandé)"
          }
        }
      }
    },
    "PC preset: the key next to the space bar (Win on a PC keyboard) runs Pavé's shortcuts, the bottom-left key does copy and paste, right ⌘ is Alt Gr. Turn it off if you keep Karabiner.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préréglage PC : la touche à côté de la barre d'espace (Windows sur un clavier PC) lance les raccourcis de Pavé, la touche en bas à gauche fait copier et coller, ⌘ droite devient Alt Gr. À couper si tu gardes Karabiner."
          }
        }
      }
    },
    "Paste": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coller"
          }
        }
      }
