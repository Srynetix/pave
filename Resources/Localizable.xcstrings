        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape %lld sur %lld"
          }
        }
      }
    },
    "Stuck against another window, it also takes the free space there: next to a window on the right two thirds, it fills the first third.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collée contre une autre fenêtre, elle prend aussi l’espace libre à côté : contre une fenêtre sur les deux tiers droits, elle remplit le premier tiers."
          }
        }
      }
    },
    "Switch windows (type to search, W closes, Q quits)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changer de fenêtre (tapez pour chercher, W ferme, Q quitte)"
          }
        }
      }
    },
